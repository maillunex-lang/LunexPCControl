[Unit]
Description=LunexPCControl owner OAuth2 PKCE authorization and read-only MCP bridge
Documentation=https://github.com/maillunex-lang/LunexPCControl
After=network.target lunexpc-gateway.service
Requires=lunexpc-gateway.service
ConditionPathExists=/var/lib/lunexpc-gateway/oauth/proxy.key

[Service]
Type=simple
User=lunexpc-gateway
Group=lunexpc-gateway
WorkingDirectory=/opt/lunexpc-gateway
ExecStart=/usr/bin/python3 -B -m server.oauth_http --bind 127.0.0.1 --port 18882 --state /var/lib/lunexpc-gateway/oauth/issuer.sqlite --owner-key /var/lib/lunexpc-gateway/panel-auth.key --proxy-key /var/lib/lunexpc-gateway/oauth/proxy.key --gateway-registry /var/lib/lunexpc-gateway/registry.sqlite
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lunexpc-gateway/oauth
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=1024
TasksMax=24
MemoryMax=128M
CPUQuota=30%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
