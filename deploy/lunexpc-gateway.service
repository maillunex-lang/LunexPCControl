[Unit]
Description=LunexPCControl authenticated read-only MCP gateway
Documentation=https://github.com/maillunex-lang/LunexPCControl
After=network.target
ConditionPathExists=/var/lib/lunexpc-gateway/registry.sqlite

[Service]
Type=simple
User=lunexpc-gateway
Group=lunexpc-gateway
WorkingDirectory=/opt/lunexpc-gateway
ExecStart=/usr/bin/python3 -m server.gateway --registry /var/lib/lunexpc-gateway/registry.sqlite --audit /var/log/lunexpc-gateway/audit.jsonl --port 18880 --screens-dir /var/lib/lunexpc-gateway/screens
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lunexpc-gateway /var/log/lunexpc-gateway
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=1024
TasksMax=32
MemoryMax=256M
CPUQuota=50%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
